# Start Carbonio, or restart it when a setting of the container changed,
# and wait until it runs: the first start runs the Carbonio setup.

import os
import subprocess
import sys

import agent
import carbonio

wanted = subprocess.run(["carbonio-prepare", "--hash"], capture_output=True, text=True, check=True).stdout.strip()
try:
    with open("runtime/started.hash") as fhash:
        started = fhash.read().strip()
except FileNotFoundError:
    started = ""

subprocess.run(["systemctl", "--user", "enable", carbonio.SERVICE], check=True)
if not carbonio.service_active() or wanted != started:
    print("Starting carbonio.service", file=sys.stderr)
    subprocess.run(["systemctl", "--user", "restart", carbonio.SERVICE], check=True)
else:
    subprocess.run(["carbonio-sync-hosts"], check=False)

agent.set_progress(20)
rc = carbonio.wait_ready(2400, progress=agent.set_progress)
if rc != 0:
    print(agent.SD_ERR + "Carbonio did not start: see the module logs", file=sys.stderr)
    sys.exit(rc)

if not carbonio.initialized():
    agent.set_env("CARBONIO_INITIALIZED", "1")
    # Only the first setup needs the administrator password
    secrets_map = carbonio.read_secrets()
    if secrets_map.pop("CARBONIO_ADMIN_PASSWORD", None) is not None:
        carbonio.write_secrets(secrets_map)
