# The core removes the volumes, the Traefik routes and the Redis keys of
# the module (the service record included). Close the mail ports and tell
# the other servers to forget this one.

import json
import os

import agent

agent.remove_public_service(os.environ["MODULE_ID"])
try:
    rdb = agent.redis_connect(privileged=True)
    rdb.delete(f"module/{os.environ['MODULE_ID']}/srv/tcp/carbonio-proxy")
    rdb.publish(f"module/{os.environ['MODULE_ID']}/event/carbonio-server-changed", json.dumps({
        "module_id": os.environ["MODULE_ID"],
        "module_uuid": os.environ.get("MODULE_UUID", ""),
    }))
except Exception as ex:
    print(agent.SD_WARNING + f"Cannot notify the other servers: {ex}", file=__import__("sys").stderr)
