{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get the Carbonio edge proxy configuration",
    "$id": "http://schema.nethserver.org/carbonio-proxy/get-configuration-output.json",
    "type": "object",
    "required": ["host", "join", "initialized", "available_masters"],
    "properties": {
        "host": {"type": "string"},
        "http2https": {"type": "boolean"},
        "lets_encrypt": {"type": "boolean"},
        "join": {"type": "string"},
        "admin_host": {"type": "string"},
        "initialized": {"type": "boolean"},
        "release": {"type": "string"},
        "ldap_secrets_set": {"type": "boolean"},
        "available_masters": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["module_id", "fqdn"],
                "properties": {
                    "module_id": {"type": "string"},
                    "fqdn": {"type": "string"},
                    "node": {"type": "string"},
                    "release": {"type": "string"},
                    "mail_domain": {"type": "string"}
                }
            }
        }
    }
}
