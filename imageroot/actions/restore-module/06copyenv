import json
import sys

import agent

request = json.load(sys.stdin)
original = request["environment"]

for name, value in original.items():
    if name.startswith("CARBONIO_") and name not in ("CARBONIO_SERVER_IMAGE", "CARBONIO_RELEASE"):
        agent.set_env(name, value)
for name in ("TRAEFIK_HOST", "TRAEFIK_HTTP2HTTPS"):
    if name in original:
        agent.set_env(name, original[name])

agent.dump_env()
