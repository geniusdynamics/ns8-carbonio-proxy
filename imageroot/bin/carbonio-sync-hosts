# Refresh state/runtime/hosts, the host names of the other servers of the
# installation: the running container applies it within 30 seconds.

import os
import carbonio

os.chdir(os.environ["AGENT_STATE_DIR"])
if carbonio.write_hosts_file():
    carbonio.log("Updated the host names of the cluster servers")
