#

#
# Before the backup: consistent dumps of the directory (LDIF) and of the
# mailbox database, next to the volume copies. restore-module loads them.
#

set -e
exec 1>&2

if ! systemctl --user -q is-active carbonio.service; then
    echo "carbonio.service is not running: the backup holds the volumes only"
    exit 0
fi
mkdir -p dump
chmod 0700 dump
podman exec carbonio /usr/local/sbin/carbonio-dump /run/ns8-carbonio/dump
