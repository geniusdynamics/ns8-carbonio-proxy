# Restart Carbonio on the new release, unless 10check_release refused it.
# The new container upgrades the data on start (carbonio-run).

import os
import subprocess
import sys

import agent
import carbonio

blocked = carbonio.env("CARBONIO_UPDATE_BLOCKED")
if blocked:
    print(agent.SD_ERR + f"Not restarting Carbonio: {blocked}", file=sys.stderr)
    sys.exit(1)
if not carbonio.initialized():
    sys.exit(0)
subprocess.run(["systemctl", "--user", "try-restart", carbonio.SERVICE], check=False)
if carbonio.service_active():
    if subprocess.run(["carbonio-wait-ready", "1800"]).returncode == 0:
        carbonio.publish_service()
