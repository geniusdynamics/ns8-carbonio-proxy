# Carbonio CE runtime image for NethServer 8.
#
# Built from the public Carbonio CE packages (https://repo.zextras.io) on
# Ubuntu 22.04. Ubuntu 22.04 is the newest base where Carbonio still ships
# the `zmcontrol` service manager: on 24.04 the services are systemd-only.
# The container therefore runs without systemd, like the Zextras images.
#
# Nothing is configured at build time: /usr/local/sbin/carbonio-run runs
# the Carbonio setup on the first start, with the passwords generated by
# the NS8 module.
#
FROM docker.io/library/ubuntu:jammy-20261020@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11

ARG DEBIAN_FRONTEND=noninteractive
# Fingerprint of the Zextras package signing key
ARG ZEXTRAS_KEY_FPR=5DC7680BC4378C471A7FA80F52FD40243E584A21

# Carbonio CE packages, pinned. Renovate bumps them as one group (see
# renovate.json): keep one package per line, as name=version.
# renovate-carbonio: suite=jammy
ARG CARBONIO_PACKAGES="\
 carbonio-core=4.6.7-3jammy \
 carbonio-mailbox-jar=4.36.6-1jammy \
 carbonio-directory-server=5.5.1-1jammy \
 carbonio-mta=4.2.8-1jammy \
 carbonio-appserver=4.5.3-1jammy \
 carbonio-proxy=4.14.11-1jammy \
 carbonio-memcached=1.6.45-1jammy \
 service-discover-server=0.7.4-1jammy \
 carbonio-admin-console-ui=0.20.6-1ubuntu \
 carbonio-admin-login-ui=0.10.2-1ubuntu \
 carbonio-auth-ui=1.6.6-1ubuntu \
 carbonio-calendars-ui=1.37.2-1ubuntu \
 carbonio-contacts-ui=1.22.0-1ubuntu \
 carbonio-login-ui=0.11.5-1ubuntu \
 carbonio-mails-ui=1.47.2-1ubuntu \
 carbonio-search-ui=0.1.5-1ubuntu \
 carbonio-shell-ui=15.3.5-1ubuntu \
 carbonio-webui-i18n=1:1.0.11-1ubuntu \
"

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

COPY pending-setups-shim /usr/local/src/pending-setups-shim

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg locales lsb-release socat tini; \
    locale-gen en_US.UTF-8; \
    curl -fsS "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x${ZEXTRAS_KEY_FPR}" -o /tmp/zextras.asc; \
    gpg --batch --show-keys --with-colons /tmp/zextras.asc | grep -q "^fpr:::::::::${ZEXTRAS_KEY_FPR}:"; \
    gpg --dearmor </tmp/zextras.asc >/usr/share/keyrings/zextras.gpg; \
    chmod 644 /usr/share/keyrings/zextras.gpg; \
    rm -f /tmp/zextras.asc; \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/zextras.gpg] https://repo.zextras.io/release/ubuntu jammy main" \
        >/etc/apt/sources.list.d/zextras.list; \
    # pending-setups is the only Carbonio package without an open source
    # licence. It registers services in the Carbonio Mesh, which this image
    # does not run: a no-op stand-in satisfies the dependency.
    dpkg-deb --root-owner-group --build /usr/local/src/pending-setups-shim /tmp/pending-setups-shim.deb; \
    dpkg -i /tmp/pending-setups-shim.deb; \
    rm -rf /tmp/pending-setups-shim.deb /usr/local/src/pending-setups-shim; \
    # resolvconf (a carbonio-core dependency) must not replace the
    # resolv.conf that the container runtime manages
    echo "resolvconf resolvconf/linkify-resolvconf boolean false" | debconf-set-selections; \
    apt-get update; \
    apt-get install -y --no-install-recommends ${CARBONIO_PACKAGES}; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*; \
    # Record what this image contains: carbonio-run compares it with the
    # release that last ran on the data, to upgrade or refuse a downgrade.
    mkdir -p /usr/share/ns8-carbonio; \
    dpkg-query -W -f='${Package} ${Version}\n' 'carbonio-*' 'service-discover-*' | sort \
        >/usr/share/ns8-carbonio/packages.txt

COPY rootfs/ /

RUN set -eux; \
    /usr/local/sbin/carbonio-image-prepare

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/sbin/carbonio-run"]
