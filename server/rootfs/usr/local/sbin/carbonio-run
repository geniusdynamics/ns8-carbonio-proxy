#!/bin/bash

#
# Copyright (C) 2026 Genius Dynamics
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Entrypoint of the NS8 Carbonio container. It runs without systemd:
#
# 1. first start: initialize the volumes and run the Carbonio setup, with
#    the passwords generated by the NS8 module (never the defaults)
# 2. image changed: upgrade the data (package files, LDAP schema) or refuse
#    a downgrade
# 3. apply the runtime settings, start the services with zmcontrol and
#    stop them cleanly on SIGTERM
#
# Input, from the environment (no secret here):
#   CARBONIO_HOSTNAME        server FQDN, also the container host name
#   CARBONIO_ROLE            allinone | mailbox | proxy
#   CARBONIO_LDAP_HOST       FQDN of the directory server (default: itself)
#   CARBONIO_MAIL_DOMAIN     first mail domain (allinone, first start)
#   CARBONIO_ADMIN_USER      administrator account local part (allinone)
#   CARBONIO_PUBLIC_HOSTNAME web host name served by Traefik
#   CARBONIO_ADMIN_HOSTNAME  optional host name of the Admin Panel route
#   CARBONIO_ANTIVIRUS       true | false
#   CARBONIO_MAILBOX_HEAP_MB Java heap of the mailbox service
#   CARBONIO_MYNETWORKS      extra trusted networks of the MTA
#   CARBONIO_TIMEZONE        default time zone of new accounts
# Secrets, from the read-only file /run/ns8-carbonio/secrets.env.
#

set -euo pipefail
umask 022
trap 'echo "carbonio-run: ERROR: line ${LINENO}: ${BASH_COMMAND} failed" >&2' ERR

ns8dir=/opt/zextras/conf/.ns8         # persistent: lives in the conf volume
dist=/usr/share/ns8-carbonio/dist     # pristine package files of this image
secrets_file=/run/ns8-carbonio/secrets.env
status_dir=/run/ns8-carbonio-status   # tmpfs, read by the health check

log() { echo "carbonio-run: $*" >&2; }
die() {
    local code=$2
    log "ERROR: $1"
    mkdir -p "${status_dir}"
    echo "$1" >"${status_dir}/error"
    exit "${code}"
}
zx() { su - zextras -c "$1"; }

: "${CARBONIO_HOSTNAME:?}"
CARBONIO_ROLE=${CARBONIO_ROLE:-allinone}
CARBONIO_LDAP_HOST=${CARBONIO_LDAP_HOST:-${CARBONIO_HOSTNAME}}
CARBONIO_PUBLIC_HOSTNAME=${CARBONIO_PUBLIC_HOSTNAME:-${CARBONIO_HOSTNAME}}
CARBONIO_ADMIN_HOSTNAME=${CARBONIO_ADMIN_HOSTNAME:-}
CARBONIO_ANTIVIRUS=${CARBONIO_ANTIVIRUS:-true}
CARBONIO_MAILBOX_HEAP_MB=${CARBONIO_MAILBOX_HEAP_MB:-1536}
CARBONIO_MYNETWORKS=${CARBONIO_MYNETWORKS:-}
CARBONIO_TIMEZONE=${CARBONIO_TIMEZONE:-UTC}

case "${CARBONIO_ROLE}" in
allinone)
    hidden_packages=""
    has_ldap=1 has_mta=1 has_mailbox=1 has_proxy=1
    ;;
mailbox)
    hidden_packages="carbonio-directory-server carbonio-mta carbonio-proxy carbonio-memcached"
    has_ldap=0 has_mta=0 has_mailbox=1 has_proxy=0
    ;;
proxy)
    hidden_packages="carbonio-directory-server carbonio-mta carbonio-appserver"
    has_ldap=0 has_mta=0 has_mailbox=0 has_proxy=1
    ;;
*)
    die "unknown CARBONIO_ROLE ${CARBONIO_ROLE}" 2
    ;;
esac

rm -rf "${status_dir}"
mkdir -p "${status_dir}"

#
# Secrets: read without eval and without ever printing them
#
declare -A secret=()
# Generated passwords are alphanumeric; the administrator's one avoids the
# characters that the Carbonio setup scripts cannot quote
generated_re='^[A-Za-z0-9_.-]+$'
admin_re='^[][A-Za-z0-9!#%&()*+,./:;<=>?@^_{|}~-]+$'
if [[ -r "${secrets_file}" ]]; then
    while IFS='=' read -r key value; do
        [[ "${key}" =~ ^CARBONIO_[A-Z_]+_PASSWORD$ ]] || continue
        if [[ "${key}" == CARBONIO_ADMIN_PASSWORD ]]; then
            [[ "${value}" =~ ${admin_re} ]] || die "invalid characters in ${key}" 2
        else
            [[ "${value}" =~ ${generated_re} ]] || die "invalid characters in ${key}" 2
        fi
        secret[${key}]=${value}
    done <"${secrets_file}"
fi
need_secret() {
    [[ -n "${secret[$1]:-}" ]] || die "missing secret $1 in ${secrets_file##*/}" 2
}

#
# Volumes: restore the owner and mode of every mount point, and fill the
# empty ones with the package files of this image
#
while read -r dir owner group mode; do
    chown "${owner}:${group}" "/opt/zextras/${dir}"
    chmod "${mode}" "/opt/zextras/${dir}"
done <"${dist}/volumes.txt"

fill_from_dist() {
    local dir=$1
    if [[ ! -e "${ns8dir}/dist-${dir}.sha256" ]]; then
        log "Initializing /opt/zextras/${dir} from the image"
        cp -a -n "${dist}/${dir}/." "/opt/zextras/${dir}/"
    fi
}

mkdir -p "${ns8dir}"
chmod 0700 "${ns8dir}"

# A first setup that did not complete leaves partial data: start again
# from clean volumes. No mailbox exists before the setup completes.
if [[ -e "${ns8dir}/bootstrap.started" && ! -e "${ns8dir}/bootstrap.done" ]]; then
    log "The previous first setup did not complete: cleaning up and starting again"
    for dir in data db ssl store index redolog; do
        find "/opt/zextras/${dir}" -mindepth 1 -delete
    done
    find /opt/zextras/conf -mindepth 1 -maxdepth 1 ! -name .ns8 -exec rm -rf {} +
    rm -f "${ns8dir}"/dist-*.sha256 "${ns8dir}/bootstrap.started"
    while read -r dir owner group mode; do
        chown "${owner}:${group}" "/opt/zextras/${dir}"
        chmod "${mode}" "/opt/zextras/${dir}"
    done <"${dist}/volumes.txt"
fi

for dir in conf data db; do
    fill_from_dist "${dir}"
done

#
# Files outside the volumes that the setup writes: saved in the conf
# volume and put back in each new container
#
carry_paths=(
    /opt/zextras/.ssh
    /opt/zextras/.install_history
    /opt/zextras/jetty_base/etc/keystore
    /var/spool/cron/crontabs/zextras
)
carry_save() {
    local path
    mkdir -p "${ns8dir}/carry"
    for path in "${carry_paths[@]}"; do
        if [[ -e "${path}" ]]; then
            mkdir -p "${ns8dir}/carry$(dirname "${path}")"
            rm -rf "${ns8dir}/carry${path}"
            cp -a "${path}" "${ns8dir}/carry${path}"
        fi
    done
}
carry_restore() {
    local path
    for path in "${carry_paths[@]}"; do
        if [[ -e "${ns8dir}/carry${path}" ]]; then
            mkdir -p "$(dirname "${path}")"
            rm -rf "${path}"
            cp -a "${ns8dir}/carry${path}" "${path}"
        fi
    done
}

record_release() {
    local dir
    for dir in conf data db; do
        cp "${dist}/${dir}.sha256" "${ns8dir}/dist-${dir}.sha256"
    done
    cp /usr/share/ns8-carbonio/packages.txt "${ns8dir}/packages.txt"
    cp "${dist}/release.txt" "${ns8dir}/release.txt"
    echo "${CARBONIO_ROLE}" >"${ns8dir}/role"
}

#
# First start: the Carbonio setup
#
write_product_config() {
    local file=$1 domain admin
    domain=${CARBONIO_MAIL_DOMAIN:-${CARBONIO_HOSTNAME#*.}}
    admin="${CARBONIO_ADMIN_USER:-admin}@${domain}"
    local create=no
    [[ ${CARBONIO_ROLE} == allinone ]] && create=yes
    (
        umask 077
        cat >"${file}" <<EOF
AVDOMAIN="${domain}"
AVUSER="${admin}"
CREATEADMIN="${admin}"
CREATEADMINPASS="${secret[CARBONIO_ADMIN_PASSWORD]:-}"
CREATEDOMAIN="${domain}"
DOCREATEADMIN="${create}"
DOCREATEDOMAIN="${create}"
DOTRAINSA="yes"
EXPANDMENU="no"
HOSTNAME="${CARBONIO_HOSTNAME}"
HTTPPORT="8080"
HTTPPROXY="TRUE"
HTTPPROXYPORT="80"
HTTPSPORT="8443"
HTTPSPROXYPORT="443"
IMAPPORT="7143"
IMAPPROXYPORT="143"
IMAPSSLPORT="7993"
IMAPSSLPROXYPORT="993"
INSTALL_WEBAPPS="service zimlet zimbra zimbraAdmin"
JAVAHOME="/opt/zextras/common/lib/jvm/java"
LDAPADMINPASS="${secret[CARBONIO_LDAP_ZIMBRA_PASSWORD]}"
LDAPAMAVISPASS="${secret[CARBONIO_LDAP_AMAVIS_PASSWORD]}"
LDAPHOST="${CARBONIO_LDAP_HOST}"
LDAPPORT="389"
LDAPPOSTPASS="${secret[CARBONIO_LDAP_POSTFIX_PASSWORD]}"
LDAPREPLICATIONTYPE="master"
LDAPREPPASS="${secret[CARBONIO_LDAP_REPLICATION_PASSWORD]}"
LDAPROOTPASS="${secret[CARBONIO_LDAP_ROOT_PASSWORD]:-}"
LDAPSERVERID="2"
MAILBOXDMEMORY="${CARBONIO_MAILBOX_HEAP_MB}"
MAILPROXY="TRUE"
MODE="https"
MYSQLMEMORYPERCENT="10"
POPPORT="7110"
POPPROXYPORT="110"
POPSSLPORT="7995"
POPSSLPROXYPORT="995"
PROXYMODE="https"
PUBLICSERVICEHOSTNAME="${CARBONIO_PUBLIC_HOSTNAME}"
REMOVE="no"
RUNAV="$([[ ${CARBONIO_ANTIVIRUS} == true && ${has_mta} == 1 ]] && echo yes || echo no)"
RUNCBPOLICYD="no"
RUNDKIM="yes"
RUNSA="yes"
SERVICEWEBAPP="yes"
SMTPDEST="${admin}"
SMTPHOST="${CARBONIO_SMTP_HOST:-${CARBONIO_LDAP_HOST}}"
SMTPSOURCE="${admin}"
STARTSERVERS="no"
STRICTSERVERNAMEENABLED="TRUE"
TRAINSAHAM="ham.carbonio@${domain}"
TRAINSASPAM="spam.carbonio@${domain}"
UIWEBAPPS="yes"
UPGRADE="yes"
VIRUSQUARANTINE="virus-quarantine.carbonio@${domain}"
ZIMBRA_REQ_SECURITY="yes"
ldap_dit_base_dn_config="cn=zimbra"
ldap_nginx_password="${secret[CARBONIO_LDAP_NGINX_PASSWORD]}"
mailboxd_directory="/opt/zextras/mailboxd"
mailboxd_keystore="/opt/zextras/mailboxd/etc/keystore"
mailboxd_keystore_password="${secret[CARBONIO_KEYSTORE_PASSWORD]}"
mailboxd_server="jetty"
mailboxd_truststore="/opt/zextras/common/lib/jvm/java/lib/security/cacerts"
mailboxd_truststore_password="changeit"
postfix_mail_owner="postfix"
postfix_setgid_group="postdrop"
ssl_default_digest="sha256"
zimbraIPMode="ipv4"
zimbraMailProxy="TRUE"
zimbraMtaMyNetworks="127.0.0.0/8 ${CARBONIO_MYNETWORKS}"
zimbraPrefTimeZoneId="${CARBONIO_TIMEZONE}"
zimbraReverseProxyLookupTarget="TRUE"
zimbraWebProxy="TRUE"
zimbra_ldap_userdn="uid=zimbra,cn=admins,cn=zimbra"
zimbra_require_interprocess_security="1"
EOF
    )
}

first_setup() {
    local pconf=/run/ns8-carbonio-setup.conf rc=0
    for key in CARBONIO_LDAP_ZIMBRA_PASSWORD CARBONIO_LDAP_AMAVIS_PASSWORD CARBONIO_LDAP_POSTFIX_PASSWORD \
        CARBONIO_LDAP_REPLICATION_PASSWORD CARBONIO_LDAP_NGINX_PASSWORD CARBONIO_KEYSTORE_PASSWORD; do
        need_secret "${key}"
    done
    if ((has_ldap)); then
        need_secret CARBONIO_LDAP_ROOT_PASSWORD
        need_secret CARBONIO_ADMIN_PASSWORD
    fi
    log "First start: running the Carbonio setup (role ${CARBONIO_ROLE}), it takes several minutes"
    touch "${ns8dir}/bootstrap.started"
    echo starting >"${status_dir}/phase"
    write_product_config "${pconf}"
    # The setup output never contains the passwords; keep it in the journal
    PATH=/usr/local/lib/ns8-carbonio/dpkg-filter:${PATH} \
        NS8_CARBONIO_HIDDEN_PACKAGES="${hidden_packages}" \
        /opt/zextras/libexec/setup.pl -c "${pconf}" || rc=$?
    rm -f "${pconf}"
    # The setup saves its configuration, lowercase password keys included
    rm -f /opt/zextras/config.*
    if ((rc != 0)); then
        die "the Carbonio setup failed with exit code ${rc}, see the log above and /opt/zextras/log/zmsetup.*.log" 1
    fi
    carry_save
    record_release
    touch "${ns8dir}/bootstrap.done"
    rm -f "${ns8dir}/bootstrap.started"
    log "Carbonio setup completed"
}

#
# Image changed: upgrade, or refuse a downgrade
#
pkg_version() { awk -v p="$1" '$1 == p { print $2 }' "$2"; }

check_versions() {
    local pkg old new verdict=same
    while read -r pkg old; do
        new=$(pkg_version "${pkg}" /usr/share/ns8-carbonio/packages.txt)
        [[ -n "${new}" ]] || continue
        if dpkg --compare-versions "${new}" lt "${old}"; then
            echo "downgrade ${pkg} ${old} ${new}"
            return
        elif dpkg --compare-versions "${new}" gt "${old}"; then
            verdict=upgrade
        fi
    done <"${ns8dir}/packages.txt"
    echo "${verdict}"
}

# Like dpkg with configuration files: a package file that the
# administrator did not change is replaced by the new one, a changed file
# is kept and the new one is saved next to it as <file>.ns8-dist
merge_dist() {
    local dir=$1 old_manifest=${ns8dir}/dist-$1.sha256 sum file current old_sum
    declare -A old=()
    if [[ -r "${old_manifest}" ]]; then
        while read -r sum file; do old[${file}]=${sum}; done <"${old_manifest}"
    fi
    while read -r sum file; do
        current="/opt/zextras/${dir}/${file#./}"
        [[ "${file}" == "./localconfig.xml" ]] && continue
        if [[ ! -e "${current}" ]]; then
            mkdir -p "$(dirname "${current}")"
            cp -a "${dist}/${dir}/${file#./}" "${current}"
            continue
        fi
        old_sum=${old[${file}]:-}
        read -r current_sum _ < <(sha256sum "${current}")
        [[ "${current_sum}" == "${sum}" ]] && continue
        if [[ -z "${old_sum}" || "${current_sum}" == "${old_sum}" ]]; then
            cp -a "${dist}/${dir}/${file#./}" "${current}"
        else
            cp -a "${dist}/${dir}/${file#./}" "${current}.ns8-dist"
            log "Kept the modified ${current}: the new version is ${current}.ns8-dist"
        fi
    done <"${dist}/${dir}.sha256"
}

upgrade_data() {
    local old_release new_release
    old_release=$(cat "${ns8dir}/release.txt" 2>/dev/null || echo unknown)
    new_release=$(cat "${dist}/release.txt")
    log "Upgrading the Carbonio data from ${old_release} to ${new_release}"
    echo upgrading >"${status_dir}/phase"
    # Safety copy of the files that the upgrade can change
    tar -C /opt/zextras -czf "${ns8dir}/pre-upgrade-conf.tar.gz" --exclude=./conf/.ns8 ./conf
    chmod 0600 "${ns8dir}/pre-upgrade-conf.tar.gz"
    for dir in conf data db; do
        merge_dist "${dir}"
    done
    if ((has_ldap)); then
        # The same steps as the carbonio-directory-server package upgrade
        log "Upgrading the LDAP schema and configuration"
        zx "/opt/zextras/bin/ldap start" || true
        zx "/opt/zextras/libexec/scripts/LDAP/LdapPreFlight.pl" || log "LdapPreFlight.pl returned non-zero"
        zx "/opt/zextras/bin/ldap stop" || true
        zx "/opt/zextras/libexec/zmldapschema" || die "zmldapschema failed: the previous configuration is in ${ns8dir}/pre-upgrade-conf.tar.gz" 1
        /opt/zextras/libexec/zmldapupdateldif || die "zmldapupdateldif failed" 1
        /opt/zextras/libexec/ldapattributeupdate || log "ldapattributeupdate returned non-zero"
    fi
    record_release
    log "Upgrade to ${new_release} completed"
}

# The mailbox refuses to start on a database schema it does not know:
# say it clearly instead
check_db_version() {
    local expected actual
    expected=$(cat "${dist}/db-version.txt")
    actual=$(zx "/opt/zextras/bin/mysql -N -B -e \"SELECT value FROM zimbra.config WHERE name='db.version'\"" 2>/dev/null || true)
    if [[ -n "${actual}" && "${actual}" != "${expected}" ]]; then
        die "the mailbox database schema is version ${actual}, this Carbonio release needs ${expected}: a manual migration is required (see the README, Upgrades)" 3
    fi
}

#
# Runtime
#
import_ca() {
    # The Java truststore of the image does not know the Carbonio CA
    local keytool=/opt/zextras/common/lib/jvm/java/bin/keytool
    local store=/opt/zextras/common/lib/jvm/java/lib/security/cacerts
    [[ -r /opt/zextras/conf/ca/ca.pem ]] || return 0
    if ! "${keytool}" -list -keystore "${store}" -storepass changeit -alias my_ca >/dev/null 2>&1; then
        "${keytool}" -importcert -noprompt -keystore "${store}" -storepass changeit \
            -alias my_ca -file /opt/zextras/conf/ca/ca.pem >/dev/null
    fi
}

apply_settings() {
    local cmds=/run/ns8-carbonio-settings.zmprov
    zx "zmlocalconfig -e mailboxd_java_heap_size=${CARBONIO_MAILBOX_HEAP_MB}" >/dev/null
    : >"${cmds}"
    if ((has_ldap)); then
        local referers="" host
        for host in ${CARBONIO_PUBLIC_HOSTNAME} ${CARBONIO_ADMIN_HOSTNAME}; do
            referers+=" zimbraCsrfAllowedRefererHosts ${host}"
        done
        {
            echo "mcf zimbraPublicServiceHostname ${CARBONIO_PUBLIC_HOSTNAME} zimbraPublicServiceProtocol https zimbraPublicServicePort 443"
            echo "mcf${referers}"
            # Every web request reaches Carbonio through Traefik on the node
            echo "mcf zimbraHttpThrottleSafeIPs 127.0.0.0/8 zimbraHttpThrottleSafeIPs 10.0.0.0/8 zimbraHttpThrottleSafeIPs 169.254.0.0/16"
            # The mailbox LMTP server fails the STARTTLS handshake (its default
            # SSL context has no key). LMTP runs inside the container, or over
            # the WireGuard network of the cluster between servers.
            echo "mcf zimbraMtaLmtpTlsSecurityLevel none"
        } >>"${cmds}"
    fi
    local antivirus=${CARBONIO_ANTIVIRUS}
    ((has_mta)) || antivirus=false
    if ((has_mta)); then
        echo "ms ${CARBONIO_HOSTNAME} zimbraMtaMyNetworks \"127.0.0.0/8 ${CARBONIO_MYNETWORKS}\"" >>"${cmds}"
        # The mailbox servers are resolved by /etc/hosts (the container
        # itself, and the cluster servers on the WireGuard network), not by
        # the DNS: deliver over LMTP with the system resolver
        echo "ms ${CARBONIO_HOSTNAME} zimbraMtaLmtpHostLookup native" >>"${cmds}"
        # Without the antivirus service amavis must not wait for ClamAV
        if [[ ${antivirus} == true ]]; then
            echo "ms ${CARBONIO_HOSTNAME} carbonioAmavisDisableVirusCheck FALSE" >>"${cmds}"
        else
            echo "ms ${CARBONIO_HOSTNAME} carbonioAmavisDisableVirusCheck TRUE" >>"${cmds}"
        fi
    fi
    local enabled
    enabled=$(zx "zmprov -l gs ${CARBONIO_HOSTNAME} zimbraServiceEnabled" || true)
    if [[ ${antivirus} == true ]] && ! grep -q ': antivirus$' <<<"${enabled}"; then
        echo "ms ${CARBONIO_HOSTNAME} +zimbraServiceEnabled antivirus" >>"${cmds}"
    elif [[ ${antivirus} != true ]] && grep -q ': antivirus$' <<<"${enabled}"; then
        echo "ms ${CARBONIO_HOSTNAME} -zimbraServiceEnabled antivirus" >>"${cmds}"
    fi
    if [[ -s "${cmds}" ]]; then
        chmod 0644 "${cmds}"
        zx "zmprov -l < ${cmds}" >/dev/null || log "Some runtime settings were not applied"
    fi
    rm -f "${cmds}"
}

# Host names of the other Carbonio servers of the cluster, resolved to
# their WireGuard addresses: /run/ns8-carbonio/hosts is written by the NS8
# module and can change while the container runs
hosts_file=/run/ns8-carbonio/runtime/hosts
hosts_applied=""
sync_hosts() {
    local current tmp
    [[ -r "${hosts_file}" ]] || return 0
    current=$(sha256sum <"${hosts_file}")
    [[ "${current}" == "${hosts_applied}" ]] && return 0
    tmp=$(mktemp)
    sed '/# ns8-carbonio begin/,/# ns8-carbonio end/d' /etc/hosts >"${tmp}"
    {
        echo "# ns8-carbonio begin"
        grep -E '^[0-9.]+[[:space:]]+[A-Za-z0-9.-]+$' "${hosts_file}" | grep -vw "${CARBONIO_HOSTNAME}" || true
        echo "# ns8-carbonio end"
    } >>"${tmp}"
    # /etc/hosts is a bind mount: rewrite it in place
    cat "${tmp}" >/etc/hosts
    rm -f "${tmp}"
    hosts_applied=${current}
    log "Updated the host names of the cluster servers"
}

# After a restore from backup: the volumes hold file copies taken while the
# services ran. Load the consistent dumps taken at the same time.
restore_dir=/run/ns8-carbonio/restore
restore_from_dumps() {
    [[ -e "${restore_dir}/restore.request" ]] || return 0
    log "Restoring the directory and the mailbox database from the backup dumps"
    echo restoring >"${status_dir}/phase"
    if ((has_ldap)) && [[ -s "${restore_dir}/ldap.ldif" ]]; then
        zx "/opt/zextras/bin/ldap stop" >/dev/null 2>&1 || true
        local aside=/opt/zextras/data/ldap/mdb/db.before-restore
        rm -rf "${aside}"
        mv /opt/zextras/data/ldap/mdb/db "${aside}"
        install -d -o zextras -g zextras -m 0750 /opt/zextras/data/ldap/mdb/db
        install -o zextras -g zextras -m 0600 "${restore_dir}/ldap.ldif" /opt/zextras/data/tmp/ns8-restore.ldif
        zx "/opt/zextras/libexec/zmslapadd /opt/zextras/data/tmp/ns8-restore.ldif" || die "loading the LDAP dump failed: the previous database is in ${aside}" 1
        rm -f /opt/zextras/data/tmp/ns8-restore.ldif
        rm -rf "${aside}"
    fi
    if ((has_mailbox)) && [[ -s "${restore_dir}/mariadb.sql.gz" ]]; then
        zx "/opt/zextras/bin/mysql.server start" >/dev/null 2>&1 || true
        local optfile
        optfile=$(mktemp)
        (
            umask 077
            printf '[client]\nuser=root\npassword=%s\nsocket=%s\n' \
                "$(zx 'zmlocalconfig -s -m nokey mysql_root_password')" \
                "$(awk -F'= *' '/^socket/ { print $2; exit }' /opt/zextras/conf/my.cnf)" >"${optfile}"
        )
        zcat "${restore_dir}/mariadb.sql.gz" | /opt/zextras/common/bin/mysql --defaults-extra-file="${optfile}" \
            || { rm -f "${optfile}"; die "loading the mailbox database dump failed" 1; }
        rm -f "${optfile}"
    fi
    rm -f "${restore_dir}/restore.request" "${restore_dir}/ldap.ldif" "${restore_dir}/mariadb.sql.gz"
    log "Restore from the backup dumps completed"
}

stopping=0
shutdown() {
    stopping=1
    log "Stopping Carbonio services"
    echo stopping >"${status_dir}/phase"
    zx "/opt/zextras/bin/zmcontrol stop" || true
    carry_save || true
    [[ -n "${cron_pid:-}" ]] && kill "${cron_pid}" 2>/dev/null || true
    [[ -n "${syslog_pid:-}" ]] && kill "${syslog_pid}" 2>/dev/null || true
    log "Stopped"
    exit 0
}
trap shutdown TERM INT

mkdir -p /var/spool/rsyslog
rsyslogd -n -f /etc/rsyslog-ns8.conf -i /run/rsyslogd.pid &
syslog_pid=$!

sync_hosts

if [[ ! -e "${ns8dir}/bootstrap.done" ]]; then
    first_setup
else
    carry_restore
    if [[ "$(cat "${ns8dir}/role" 2>/dev/null)" != "${CARBONIO_ROLE}" ]]; then
        die "the data belongs to a ${CARBONIO_ROLE:-different} role ($(cat "${ns8dir}/role")): the role of an installed server cannot change" 3
    fi
    read -r verdict pkg old new < <(check_versions)
    case "${verdict}" in
    downgrade)
        die "refusing to start: this image has ${pkg} ${new}, older than ${old} that last ran on this data. Downgrades are not supported: install the previous module version again, or restore a backup taken with it" 3
        ;;
    upgrade)
        upgrade_data
        ;;
    esac
fi

sync_hosts
restore_from_dumps
import_ca

/usr/sbin/cron -f &
cron_pid=$!

if ((has_ldap)); then
    zx "/opt/zextras/bin/ldap start" >/dev/null || true
fi
if ((has_mailbox)); then
    zx "/opt/zextras/bin/mysql.server start" >/dev/null 2>&1 || true
    check_db_version
fi
apply_settings

log "Starting Carbonio services"
echo starting >"${status_dir}/phase"
if ! zx "/opt/zextras/bin/zmcontrol start"; then
    log "zmcontrol start reported an error: the health check shows which service is down"
fi
echo running >"${status_dir}/phase"
log "Carbonio is running"

while ((!stopping)); do
    sleep 30 &
    wait $! || true
    sync_hosts || true
done
